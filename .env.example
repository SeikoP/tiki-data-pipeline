
# ============================================
# TIKI DATA PIPELINE CONFIGURATION
# ============================================

# --- Docker & Airflow System ---
AIRFLOW_IMAGE_NAME=
AIRFLOW_PROJ_DIR=.
ENV_FILE_PATH=.env
AIRFLOW_UID=1000
AIRFLOW_GID=0

# --- Database Credentials (Clean Setup) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
# --- Airflow Web UI Admin ---
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
_AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW__CORE__SECRET_KEY=
AIRFLOW__CORE__FERNET_KEY=

# --- Crawl Configuration ---
# Root Category để crawl đệ quy
#CRAWL_ROOT_CATEGORY_URL=https://tiki.vn/nha-cua-doi-song/c1883
TIKI_PRODUCTS_PER_DAY=

# Redis (Optional)
REDIS_PASSWORD=

# --- DAG Schedule Configuration ---
# Chế độ chạy: 'manual' (thủ công) hoặc 'scheduled' (tự động)
AIRFLOW_VAR_TIKI_DAG_SCHEDULE_MODE="manual"

# Khoảng cách giữa các lần chạy tự động (theo giờ)
AIRFLOW_VAR_TIKI_DAG_SCHEDULE_HOURS="1"

# --- AI Configuration (Groq or OpenRouter) ---
AI_ENABLED=
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# --- Legacy Groq Configuration (Optional) ---
GROQ_ENABLED=
GROQ_API_KEY=

# --- Discord Notification ---
DISCORD_ENABLED=
DISCORD_WEBHOOK_URL=
DISCORD_MONITORING_WEBHOOK_URL=

# ============================================
# PERFORMANCE OPTIMIZATION FEATURE FLAGS
# ============================================

# --- Async I/O Optimization (Task 14.1) ---
# Enable async crawler for improved concurrency
USE_ASYNC_CRAWLER=false
ASYNC_CONNECTOR_LIMIT=300
ASYNC_BATCH_SIZE=50
ASYNC_TIMEOUT_TOTAL=15
ASYNC_TIMEOUT_CONNECT=10

# --- Vectorized Transformation (Task 14.2) ---
# Enable vectorized operations using NumPy/Pandas
USE_VECTORIZED_TRANSFORM=false

# --- Optimized Batch Loading (Task 14.3) ---
# Enable optimized database batch operations
USE_OPTIMIZED_LOADER=false
OPTIMIZED_BATCH_SIZE=1000
USE_COPY_COMMAND=true

# --- Short Name AI Configuration ---
SHORT_NAME_USE_AI=true
