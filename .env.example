# ==============================================================================
# TIKI DATA PIPELINE - ENV TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in local secrets before running Docker Compose.
# Keep real credentials, tokens, and webhook URLs out of git.

# ==============================================================================
# LOCAL COMPOSE / CONTAINER RUNTIME
# ==============================================================================
# Used by Docker Compose before containers start.
ENV_FILE_PATH=.env
AIRFLOW_IMAGE_NAME=
AIRFLOW_PROJ_DIR=.
AIRFLOW_UID=1000
AIRFLOW_GID=0

# ==============================================================================
# POSTGRESQL
# ==============================================================================
# Shared by the crawl database and Airflow metadata database.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tiki
POSTGRES_USER=
POSTGRES_PASSWORD=

# ==============================================================================
# REDIS
# ==============================================================================
# Required for local Docker Compose Redis auth and cache clients.
REDIS_PASSWORD=

# ==============================================================================
# AIRFLOW AUTH / SECRETS
# ==============================================================================
# Keep these private. Generate new keys for real deployments.
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW__CORE__SECRET_KEY=
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:Admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/external/passwords.json

# ==============================================================================
# AIRFLOW DATABASE
# ==============================================================================
# Metadata database connection and SQLAlchemy pool tuning.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=

# ==============================================================================
# TIKI DAG SCHEDULE
# ==============================================================================
# manual = run on demand, scheduled = periodic DAG schedule.
AIRFLOW_VAR_TIKI_DAG_SCHEDULE_MODE="manual"
AIRFLOW_VAR_TIKI_DAG_SCHEDULE_HOURS="1"

# ==============================================================================
# TIKI CRAWL LIMITS
# ==============================================================================
# Controls category crawl and product detail crawl volume/concurrency.
TIKI_PRODUCTS_PER_DAY=
TIKI_DETAIL_ACTIVE_BATCHES=6
TIKI_DETAIL_BATCH_SIZE=500
TIKI_DETAIL_MAX_CONCURRENT_TASKS=8
TIKI_DETAIL_CONCURRENCY_MIN=4
TIKI_DETAIL_CONCURRENCY_MAX=10

# ==============================================================================
# TIKI LOAD / RESILIENCE
# ==============================================================================
# Controls database load strategy, batch size, and failure behavior.
TIKI_LOAD_MODE=auto
TIKI_LOAD_OPTIMIZED_THRESHOLD=1000

# ==============================================================================
# PERFORMANCE FEATURE FLAGS
# ==============================================================================
# Optional pipeline optimizations. Toggle carefully and test after changing.
USE_ASYNC_CRAWLER=false
ASYNC_CONNECTOR_LIMIT=300
ASYNC_BATCH_SIZE=50
ASYNC_TIMEOUT_TOTAL=15
ASYNC_TIMEOUT_CONNECT=10
USE_VECTORIZED_TRANSFORM=false
USE_OPTIMIZED_LOADER=false
OPTIMIZED_BATCH_SIZE=1000
USE_COPY_COMMAND=true

# ==============================================================================
# AI / SHORT NAME
# ==============================================================================
# AI provider configuration used by summary/short-name features.
AI_ENABLED=
AI_API_KEY=
AI_API_BASE=
AI_MODEL=
GROQ_ENABLED=
GROQ_API_KEY=
SHORT_NAME_USE_AI=true

# ==============================================================================
# DISCORD NOTIFICATIONS
# ==============================================================================
# Webhook URLs are secrets. Leave blank to disable destinations.
DISCORD_ENABLED=
DISCORD_WEBHOOK_URL=
DISCORD_MONITORING_WEBHOOK_URL=
